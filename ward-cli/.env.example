# Copy to .env (never commit .env). Missing secrets are generated on first run.

# preprod (needs a Blockfrost project ID), preview, or undeployed (local devnet)
WARD_NETWORK=preprod

# Free at https://blockfrost.io: create a project for "Midnight Preprod" and paste its ID here
BLOCKFROST_PROJECT_ID=

# Proof server used to build zero-knowledge proofs (start one with: npm run proof-server)
WARD_PROOF_SERVER=http://localhost:6300

# Generated automatically: deployer wallet seed, operator secret, local state password
WARD_WALLET_SEED=
WARD_OPERATOR_SECRET=
WARD_STATE_PASSWORD=
